{
  "id": "com.ericj.senseenergymonitor",
  "version": "0.1.0",
  "compatibility": ">=10.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Sense Energy Monitor"
  },
  "description": {
    "en": "Port of the Home Assistant Sense Energy Monitor integration for Homey."
  },
  "category": [
    "energy"
  ],
  "permissions": [],
  "author": {
    "name": "Eric Jilot"
  },
  "source": "https://github.com/EricJilot/homey-sense-energy-monitor",
  "bugs": {
    "url": "https://github.com/EricJilot/homey-sense-energy-monitor/issues"
  },
  "brandColor": "#FF8C00",
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "drivers": [
    {
      "id": "sense_monitor",
      "name": {
        "en": "Sense Monitor"
      },
      "class": "sensor",
      "capabilities": [
        "measure_power",
        "measure_power.consumption",
        "meter_power",
        "meter_power.imported",
        "meter_power.exported"
      ],
      "capabilitiesOptions": {
        "measure_power": {
          "title": {
            "en": "Grid"
          }
        },
        "measure_power.consumption": {
          "title": {
            "en": "Home usage"
          }
        },
        "meter_power": {
          "title": {
            "en": "Total used"
          }
        },
        "meter_power.imported": {
          "title": {
            "en": "Imported"
          }
        },
        "meter_power.exported": {
          "title": {
            "en": "Exported"
          }
        }
      },
      "energy": {
        "cumulative": true,
        "cumulativeImportedCapability": "meter_power.imported",
        "cumulativeExportedCapability": "meter_power.exported"
      },
      "pair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "logo": "icon.svg",
            "usernameLabel": {
              "en": "Email address"
            },
            "usernamePlaceholder": {
              "en": "you@example.com"
            },
            "passwordLabel": {
              "en": "Password"
            }
          }
        },
        {
          "id": "mfa",
          "template": "pincode",
          "options": {
            "type": "number",
            "length": 6,
            "title": {
              "en": "Two-factor authentication"
            },
            "hint": {
              "en": "Enter the 6-digit code from your authenticator app."
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "energyRefreshMinutes",
          "type": "number",
          "label": {
            "en": "Energy refresh interval"
          },
          "value": 5,
          "min": 1,
          "max": 60,
          "units": {
            "en": "minutes"
          },
          "hint": {
            "en": "How often the total energy reading is refreshed. Live power arrives continuously and is not affected by this setting."
          }
        }
      ]
    },
    {
      "id": "sense_solar",
      "name": {
        "en": "Sense Solar"
      },
      "class": "solarpanel",
      "capabilities": [
        "measure_power",
        "meter_power"
      ],
      "capabilitiesOptions": {
        "measure_power": {
          "title": {
            "en": "Producing"
          }
        },
        "meter_power": {
          "title": {
            "en": "Total produced"
          }
        }
      },
      "pair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "logo": "icon.svg",
            "usernameLabel": {
              "en": "Email address"
            },
            "usernamePlaceholder": {
              "en": "you@example.com"
            },
            "passwordLabel": {
              "en": "Password"
            }
          }
        },
        {
          "id": "mfa",
          "template": "pincode",
          "options": {
            "type": "number",
            "length": 6,
            "title": {
              "en": "Two-factor authentication"
            },
            "hint": {
              "en": "Enter the 6-digit code from your authenticator app."
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "energyRefreshMinutes",
          "type": "number",
          "label": {
            "en": "Energy refresh interval"
          },
          "value": 5,
          "min": 1,
          "max": 60,
          "units": {
            "en": "minutes"
          },
          "hint": {
            "en": "How often the total production reading is refreshed. Live power arrives continuously and is not affected by this setting."
          }
        }
      ]
    }
  ]
}
