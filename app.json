  "flow": {
    "actions": [
      {
        "id": "refresh_totals",
        "title": {
          "en": "Refresh energy totals"
        },
        "titleFormatted": {
          "en": "Refresh energy totals on [[device]]"
        },
        "hint": {
          "en": "Fetches the latest totals from Sense immediately, instead of waiting for the next scheduled refresh."
        },
        "args": [
          {
            "name": "device",
            "type": "device"
          }
        ]
      }
    ],
    "triggers": [
      {
        "id": "export_started",
        "title": {
          "en": "Started exporting to the grid"
        },
        "hint": {
          "en": "Triggers when solar production exceeds household demand by more than the configured threshold."
        },
        "tokens": [
          {
            "name": "grid",
            "type": "number",
            "title": {
              "en": "Grid"
            },
            "example": -812
          },
          {
            "name": "solar",
            "type": "number",
            "title": {
              "en": "Solar"
            },
            "example": 3200
          },
          {
            "name": "consumption",
            "type": "number",
            "title": {
              "en": "Home usage"
            },
            "example": 2388
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=sense_monitor"
          }
        ]
      },
      {
        "id": "export_stopped",
