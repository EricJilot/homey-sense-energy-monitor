{
  "id": "com.ericj.senseenergymonitor",
  "version": "0.1.0",
  "compatibility": ">=10.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Sense Energy Monitor"
  },
  "description": {
    "en": "Port of the Home Assistant Sense Energy Monitor integration for Homey."
  },
  "category": [
    "energy"
  ],
  "permissions": [],
  "author": {
    "name": "Eric J"
  },
  "brandColor": "#0066cc",
  "images": {
    "large": "/assets/screenshot_1.svg",
    "small": "/assets/screenshot_2.svg"
  },
  "drivers": [
    {
      "id": "sense_monitor",
      "name": {
        "en": "Sense Monitor"
      },
      "class": "sensor",
      "capabilities": [
        "measure_power",
        "meter_power"
      ],
      "pair": [
        {
          "id": "login",
          "template": "login",
          "title": {
            "en": "Sense Account Login"
          }
        },
        {
          "id": "mfa",
          "template": "text_input",
          "title": {
            "en": "Two-Factor Authentication"
          },
          "text": {
            "en": "Enter the 6-digit code from your authenticator app"
          },
          "placeholder": {
            "en": "000000"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "title": {
            "en": "Select Sense Monitor"
          }
        }
      ]
    }
  ]
}
